{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://motiongraphic.local/contracts/addon.schema.json",
  "title":"MotionGraphic Studio folder-first addon contract v1",
  "type":"object",
  "required":["id","slug","title","entry","exportName","width","height","fps","durationInFrames","defaultProps"],
  "properties":{
    "contractVersion":{"const":"1.0.0"},
    "id":{"type":"string","pattern":"^[A-Z][A-Za-z0-9]{2,80}$"},
    "slug":{"type":"string","pattern":"^[a-z][a-z0-9-]{1,48}$"},
    "title":{"type":"string","minLength":1},
    "entry":{"type":"string","pattern":"^src/[A-Za-z0-9_./-]+\\.(tsx|jsx)$"},
    "exportName":{"type":"string","pattern":"^[A-Za-z_$][A-Za-z0-9_$]*$"},
    "width":{"type":"integer","minimum":1,"maximum":8192},
    "height":{"type":"integer","minimum":1,"maximum":8192},
    "fps":{"type":"integer","minimum":1,"maximum":120},
    "durationInFrames":{"type":"integer","minimum":1,"maximum":1000000},
    "defaultProps":{"type":"object"},
    "segments":{"type":"array"}
  },
  "additionalProperties":true
}
