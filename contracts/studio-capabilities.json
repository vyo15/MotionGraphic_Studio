{
  "schemaVersion": 1,
  "engine": "MotionGraphic-Studio",
  "masterVersion": "2.0.0",
  "addonContractVersion": "1.0.0",
  "remotionVersion": "4.0.538",
  "nodeMinimumMajor": 22,
  "folderFirst": "projects/<slug>/",
  "registration": "npm run sync",
  "assetPrefix": "videos/<slug>/",
  "videoExport": "export const Video",
  "voiceOverWorkflow": "motion -> visual-approval -> guide -> record -> sync -> qa -> final",
  "voiceGuide": {
    "narrationSchemaVersion": 1,
    "editor": "Remotion Props (VO Guide composition) / CLI fallback",
    "source": "src/config/narration.json"
  },
  "supportedEditable": [
    "native Remotion Interactive",
    "Studio props",
    "interpolate",
    "spring"
  ],
  "requiredRootFiles": [
    "motiongraphic-video.json",
    "src/Video.tsx",
    "README.md",
    "PANDUAN-EDIT-ASSET.md"
  ],
  "restrictions": [
    "never overwrite a pre-existing project",
    "no new runtime dependencies without updating Master",
    "do not change master generated Root/catalog",
    "no implicit deletion of approved files"
  ],
  "exportedAt": "generated from package.json (no timestamp)",
  "pluginDependencies": [
    "@remotion/cli",
    "remotion",
    "react",
    "react-dom"
  ],
  "validation": {
    "version": "1.1",
    "strict": "kontrak, asset literal, dynamic import/source lint; tidak menggantikan bundling",
    "command": "npm run addon:validate -- <folder-addon> --strict --syntax",
    "smokeCommand": "npm run qa:smoke -- --still <CompositionId>",
    "verification": "static != render"
  },
  "revisionSafety": "SHA-256, preflight on isolated candidate project, rollback",
  "creativeStyleBridge": {
    "default": "minimal-editorial",
    "profiles": "contracts/creative-style-profiles.json",
    "mode": "reference-only",
    "renderer": "remotion"
  },
  "studioUserFlow": {
    "command": "npm run flow",
    "briefOutput": "exports/briefs",
    "source": "PRODUCTION-RULES.md"
  },
  "masterZipDefault": "engine-only (no projects, no historical logs)",
  "productionStandards": {
    "motionDirection": "3.0",
    "motionPlanContract": "focus-driven-v1",
    "projectRules": "2.0",
    "editableContract": "studio-direct-v4",
    "motionQA": "npm run qa:motion -- <folder-addon>",
    "motionQAAll": "npm run qa:motion -- --all",
    "productionGate": "npm run addon:validate -- <folder-addon> --production --syntax",
    "releaseCheck": "npm run release:check",
    "legacyPolicy": "No forced migration; --production is explicit for new videos",
    "verification": "Motion/geometry metadata and timestamp proposals only; DOM, GUI, bundling, render and listening separate",
    "productionToolkit": "1.0",
    "spatialQA": "npm run qa:spatial -- <folder-addon>",
    "voAlignment": "npm run vo:align -- <folder-addon> <phrases.json>",
    "approvalQA": "npm run qa:approval",
    "soundDirection": "2.2",
    "soundImplementationContract": "cue-track-v1",
    "soundQA": "npm run qa:sound -- <folder-addon> --strict"
  }
}
