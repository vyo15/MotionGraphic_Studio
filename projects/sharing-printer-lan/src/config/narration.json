  "beats": [
    {
      "scene": "S01",
      "startFrame": 0,
      "endFrame": 78,
      "text": "Printer kamu belum punya fitur Wi-Fi?"
    },
    {
      "scene": "S01",
      "startFrame": 78,
      "endFrame": 135,
      "text": "Tenang, ternyata ada cara"
    },
    {
      "scene": "S01",
      "startFrame": 135,
      "endFrame": 210,
      "text": "supaya satu printer bisa digunakan"
    },
    {
      "scene": "S01",
      "startFrame": 210,
      "endFrame": 276,
      "text": "oleh beberapa komputer."
    },
    {
      "scene": "S02",
      "startFrame": 276,
      "endFrame": 354,
      "text": "Caranya, kita cukup manfaatin"
    },
    {
      "scene": "S02",
      "startFrame": 354,
      "endFrame": 444,
      "text": "fitur Printer Sharing yang udah ada di Windows."
    },
    {
      "scene": "S02",
      "startFrame": 444,
      "endFrame": 510,
      "text": "Pertama, pastikan kedua komputer ini"
    },
    {
      "scene": "S02",
      "startFrame": 510,
      "endFrame": 606,
      "text": "udah terhubung ke jaringan yang sama."
    },
    {
      "scene": "S03",
      "startFrame": 606,
      "endFrame": 708,
      "text": "Selanjutnya, di komputer yang terhubung langsung ke printer,"
    },
    {
      "scene": "S03",
      "startFrame": 708,
      "endFrame": 788,
      "text": "buka Control Panel,"
    },
    {
      "scene": "S03",
      "startFrame": 788,
      "endFrame": 921,
      "text": "lalu masuk ke Network and Sharing Center."
    },
    {
      "scene": "S03",
      "startFrame": 921,
      "endFrame": 1008,
      "text": "Pilih Change advanced sharing settings,"
    },
    {
      "scene": "S03",
      "startFrame": 1008,
      "endFrame": 1124,
      "text": "kemudian aktifkan Network Discovery"
    },
    {
      "scene": "S03",
      "startFrame": 1124,
      "endFrame": 1224,
      "text": "dan File and Printer Sharing."
    },
    {
      "scene": "S03",
      "startFrame": 1224,
      "endFrame": 1326,
      "text": "Kalau udah, klik Save changes."
    },
    {
      "scene": "S04",
      "startFrame": 1326,
      "endFrame": 1476,
      "text": "Setelah itu, masuk ke pengaturan printer,"
    },
    {
      "scene": "S04",
      "startFrame": 1476,
      "endFrame": 1566,
      "text": "pilih printer yang mau kita sharing, lalu buka Printer Properties."
    },
    {
      "scene": "S04",
      "startFrame": 1566,
      "endFrame": 1656,
      "text": "Masuk ke tab Sharing,"
    },
    {
      "scene": "S04",
      "startFrame": 1656,
      "endFrame": 1776,
      "text": "centang Share this printer,"
    },
    {
      "scene": "S04",
      "startFrame": 1776,
      "endFrame": 1866,
      "text": "lalu klik OK."
    },
    {
      "scene": "S05",
      "startFrame": 1866,
      "endFrame": 1950,
      "text": "Sekarang, kita pindah ke komputer kedua."
    },
    {
      "scene": "S05",
      "startFrame": 1950,
      "endFrame": 1998,
      "text": "Tekan Windows plus R,"
    },
    {
      "scene": "S05",
      "startFrame": 1998,
      "endFrame": 2106,
      "text": "lalu masukkan alamat IP komputer pertama."
    },
    {
      "scene": "S05",
      "startFrame": 2106,
      "endFrame": 2154,
      "text": "Kalau printernya udah muncul,"
    },
    {
      "scene": "S05",
      "startFrame": 2154,
      "endFrame": 2316,
      "text": "tinggal klik kanan dan pilih Connect."
    },
    {
      "scene": "S06",
      "startFrame": 2316,
      "endFrame": 2436,
      "text": "Nah, sekarang kita udah bisa nge-print"
    },
    {
      "scene": "S06",
      "startFrame": 2436,
      "endFrame": 2586,
      "text": "dari kedua komputer tanpa perlu Wi-Fi."
    },
    {
      "scene": "S06",
      "startFrame": 2586,
      "endFrame": 2661,
      "text": "Tapi pastikan komputer yang terhubung langsung ke printer"
    },
    {
      "scene": "S06",
      "startFrame": 2661,
      "endFrame": 2706,
      "text": "tetap menyala, ya."
    },
    {
      "scene": "S07",
      "startFrame": 2706,
      "endFrame": 2768,
      "text": "Kalau kamu punya pengalaman"
    },
    {
      "scene": "S07",
      "startFrame": 2768,
      "endFrame": 2825,
      "text": "soal sharing printer,"
    },
    {
      "scene": "S07",
      "startFrame": 2825,
      "endFrame": 2931,
      "text": "coba tulis di kolom komentar."
    },
    {
      "scene": "S08",
      "startFrame": 2931,
      "endFrame": 3111,
      "text": ""
    }
  ]
}
