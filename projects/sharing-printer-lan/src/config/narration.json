  "beats": [
    {
      "scene": "S01-Question",
      "startFrame": 0,
      "endFrame": 198,
      "text": "Printer kamu belum punya fitur Wi-Fi?"
    },
    {
      "scene": "S01-Response",
      "startFrame": 198,
      "endFrame": 282,
      "text": "Tenang, ternyata ada cara"
    },
    {
      "scene": "S01",
      "startFrame": 282,
      "endFrame": 407,
      "text": "supaya satu printer bisa digunakan"
    },
    {
      "scene": "S01",
      "startFrame": 407,
      "endFrame": 526,
      "text": "oleh beberapa komputer."
    },
    {
      "scene": "S01",
      "startFrame": 526,
      "endFrame": 560,
      "text": ""
    },
    {
      "scene": "S02",
      "startFrame": 560,
      "endFrame": 638,
      "text": "Caranya, kita cukup manfaatin"
    },
    {
      "scene": "S02",
      "startFrame": 638,
      "endFrame": 728,
      "text": "fitur Printer Sharing yang udah ada di Windows."
    },
    {
      "scene": "S02",
      "startFrame": 728,
      "endFrame": 794,
      "text": "Pertama, pastikan kedua komputer ini"
    },
    {
      "scene": "S02",
      "startFrame": 794,
      "endFrame": 890,
      "text": "udah terhubung ke jaringan yang sama."
    },
    {
      "scene": "S03",
      "startFrame": 890,
      "endFrame": 992,
      "text": "Selanjutnya, di komputer yang terhubung langsung ke printer,"
    },
    {
      "scene": "S03",
      "startFrame": 992,
      "endFrame": 1072,
      "text": "buka Control Panel,"
    },
    {
      "scene": "S03",
      "startFrame": 1072,
      "endFrame": 1205,
      "text": "lalu masuk ke Network and Sharing Center."
    },
    {
      "scene": "S03",
      "startFrame": 1205,
      "endFrame": 1292,
      "text": "Pilih Change advanced sharing settings,"
    },
    {
      "scene": "S03",
      "startFrame": 1292,
      "endFrame": 1408,
      "text": "kemudian aktifkan Network Discovery"
    },
    {
      "scene": "S03",
      "startFrame": 1408,
      "endFrame": 1508,
      "text": "dan File and Printer Sharing."
    },
    {
      "scene": "S03",
      "startFrame": 1508,
      "endFrame": 1610,
      "text": "Kalau udah, klik Save changes."
    },
    {
      "scene": "S04",
      "startFrame": 1610,
      "endFrame": 1760,
      "text": "Setelah itu, masuk ke pengaturan printer,"
    },
    {
      "scene": "S04",
      "startFrame": 1760,
      "endFrame": 1850,
      "text": "pilih printer yang mau kita sharing, lalu buka Printer Properties."
    },
    {
      "scene": "S04",
      "startFrame": 1850,
      "endFrame": 1940,
      "text": "Masuk ke tab Sharing,"
    },
    {
      "scene": "S04",
      "startFrame": 1940,
      "endFrame": 2060,
      "text": "centang Share this printer,"
    },
    {
      "scene": "S04",
      "startFrame": 2060,
      "endFrame": 2150,
      "text": "lalu klik OK."
    },
    {
      "scene": "S05",
      "startFrame": 2150,
      "endFrame": 2234,
      "text": "Sekarang, kita pindah ke komputer kedua."
    },
    {
      "scene": "S05",
      "startFrame": 2234,
      "endFrame": 2282,
      "text": "Tekan Windows plus R,"
    },
    {
      "scene": "S05",
      "startFrame": 2282,
      "endFrame": 2390,
      "text": "lalu masukkan alamat IP komputer pertama."
    },
    {
      "scene": "S05",
      "startFrame": 2390,
      "endFrame": 2438,
      "text": "Kalau printernya udah muncul,"
    },
    {
      "scene": "S05",
      "startFrame": 2438,
      "endFrame": 2600,
      "text": "tinggal klik kanan dan pilih Connect."
    },
    {
      "scene": "S06",
      "startFrame": 2600,
      "endFrame": 2720,
      "text": "Nah, sekarang kita udah bisa nge-print"
    },
    {
      "scene": "S06",
      "startFrame": 2720,
      "endFrame": 2870,
      "text": "dari kedua komputer tanpa perlu Wi-Fi."
    },
    {
      "scene": "S06",
      "startFrame": 2870,
      "endFrame": 2945,
      "text": "Tapi pastikan komputer yang terhubung langsung ke printer"
    },
    {
      "scene": "S06",
      "startFrame": 2945,
      "endFrame": 2990,
      "text": "tetap menyala, ya."
    },
    {
      "scene": "S07",
      "startFrame": 2990,
      "endFrame": 3052,
      "text": "Kalau kamu punya pengalaman"
    },
    {
      "scene": "S07",
      "startFrame": 3052,
      "endFrame": 3109,
      "text": "soal sharing printer,"
    },
    {
      "scene": "S07",
      "startFrame": 3109,
      "endFrame": 3215,
      "text": "coba tulis di kolom komentar."
    },
    {
      "scene": "S08",
      "startFrame": 3215,
      "endFrame": 3395,
      "text": ""
    }
  ]
}
