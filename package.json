{
  "name": "motiongraphic-studio-master",
  "version": "1.8.1",
  "private": true,
  "description": "Satu Master folder-first; hanya Remotion Studio sebagai editor dan preview, tanpa UI/editor tambahan",
  "scripts": {
    "predev": "node tools/prepare-studio.mjs",
    "dev": "node tools/start-studio.mjs",
    "studio": "npm run dev",
    "import": "node tools/import-inbox.mjs && node tools/sync-projects.mjs && node tools/validate-library.mjs",
    "add": "node tools/add-video.mjs",
    "list": "node tools/list-videos.mjs",
    "delete": "node tools/delete-video.mjs",
    "restore": "node tools/restore-video.mjs",
    "prerender": "node tools/prepare-studio.mjs",
    "render": "node tools/render-menu.mjs",
    "validate": "node tools/validate-library.mjs",
    "check": "node tools/sync-projects.mjs && node tools/validate-library.mjs && node tools/check-editability.mjs --strict && node tools/check-direct-studio-text.mjs && node tools/check-layout-flow.mjs && node tools/studio-check.mjs && tsc --noEmit",
    "sync": "node tools/sync-projects.mjs && node tools/validate-library.mjs",
    "zip": "node tools/zip-video.mjs",
    "addfolder": "node tools/add-folder.mjs",
    "rename": "node tools/rename-video.mjs",
    "doctor": "node tools/doctor.mjs",
    "menu": "node tools/studio-menu.mjs",
    "editcheck": "node tools/check-editability.mjs",
    "qa": "node tools/studio-check.mjs",
    "skills": "node tools/remotion-skills.mjs status",
    "skills:install": "node tools/remotion-skills.mjs install",
    "test": "node --test tests/*.test.mjs",
    "concat": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File tools/concat-manager.ps1 -Action launch",
    "concat:setup": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File tools/concat-manager.ps1 -Action setup",
    "concat:status": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File tools/concat-manager.ps1 -Action status",
    "concat:clone": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File tools/concat-manager.ps1 -Action clone",
    "concat:safe": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File tools/concat-manager.ps1 -Action launch -SoftwareGraphics",
    "handoff": "node tools/export-concat-segments.mjs"
  },
  "dependencies": {
    "@remotion/cli": "4.0.538",
    "remotion": "4.0.538",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "typescript": "^5.5.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0"
  }
}
