{
  "name": "motiongraphic-studio-master",
  "version": "2.0.0",
  "private": true,
  "description": "Satu Master folder-first, Remotion Studio saja; tanpa Concat atau editor tambahan",
  "scripts": {
    "predev": "node tools/prepare-studio.mjs",
    "dev": "node tools/start-studio.mjs",
    "studio": "npm run dev",
    "import": "node tools/import-inbox.mjs && node tools/sync-projects.mjs && node tools/validate-library.mjs",
    "add": "node tools/add-video.mjs",
    "list": "node tools/list-videos.mjs",
    "delete": "node tools/delete-video.mjs",
    "restore": "node tools/restore-video.mjs",
    "prerender": "node tools/prepare-studio.mjs",
    "render": "node tools/render-menu.mjs",
    "validate": "node tools/validate-library.mjs",
    "check": "node tools/check-editability.mjs --strict && node tools/studio-check.mjs",
    "sync": "node tools/sync-projects.mjs && node tools/validate-library.mjs",
    "vo:init": "node tools/vo-init.mjs",
    "zip": "node tools/zip-video.mjs",
    "addfolder": "node tools/add-folder.mjs",
    "rename": "node tools/rename-video.mjs",
    "doctor": "node tools/doctor.mjs",
    "menu": "node tools/studio-menu.mjs",
    "editcheck": "node tools/check-editability.mjs",
    "qa": "node tools/studio-check.mjs",
    "skills": "node tools/remotion-skills.mjs status",
    "skills:install": "node tools/remotion-skills.mjs install",
    "test": "node --test tests/*.test.mjs",
    "addon:validate": "node tools/validate-addon.mjs",
    "addon:patch": "node tools/apply-addon-patch.mjs",
    "addon:patch-create": "node tools/create-addon-patch.mjs",
    "addon:scaffold": "node tools/scaffold-addon.mjs",
    "capabilities": "node tools/export-capabilities.mjs",
    "vo:edit": "node tools/vo-edit.mjs",
    "qa:render": "node tools/qa-render.mjs",
    "check:syntax": "node tools/check-source-syntax.mjs",
    "qa:smoke": "node tools/smoke-remotion.mjs",
    "check:sync": "node tools/check-sync-state.mjs",
    "flow": "node tools/project-flow.mjs",
    "clean": "node tools/clean-master.mjs",
    "backup:editing": "node tools/studio-session-backup.mjs",
    "retire:unregistered": "node tools/retire-unregistered.mjs",
    "qa:sound": "node tools/qa-sound-cues.mjs",
    "qa:layers": "node tools/check-layer-instances.mjs",
    "qa:native": "node tools/qa-native-editable.mjs --strict",
    "qa:motion": "node tools/qa-motion-plan.mjs",
    "release:check": "node tools/check-release.mjs",
    "qa:spatial": "node tools/qa-spatial.mjs",
    "vo:align": "node tools/vo-align.mjs",
    "qa:approval": "node tools/production-scope.mjs"
  },
  "dependencies": {
    "@remotion/cli": "4.0.538",
    "remotion": "4.0.538",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "typescript": "^5.5.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0"
  }
}
